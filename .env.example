# Copier vers .env (ne jamais commiter .env) et remplir les secrets.
# chmod 600 .env
# Aucune de ces valeurs ne doit apparaître dans un ticket, un chat ou un journal.

# --- Secrets (obligatoires) ---
DISCORD_BOT_TOKEN=
ROUTINE_WEBHOOK_URL=
ROUTINE_WEBHOOK_KEY=

# Secret partagé pour l'API HTTP /act et /run (déploiement Fly).
# Généré automatiquement par deploy/fly/deploy-fly.sh si absent.
ACT_SHARED_SECRET=

# URL du pont distant, uniquement si la routine tourne ailleurs que sur la machine du pont.
# ACT_REMOTE_URL=https://cum-slayer-bridge.fly.dev

# --- Identité et périmètre (valeurs d'exemple = serveur de production « Le Royaume ») ---
BOT_APP_ID=1574150367325855856
CREATOR_ID=965544860528562216
GUILD_ID=1095123126746099834
ALLOWED_GUILDS=1095123126746099834
AGENTS_CATEGORY_ID=1574094410830844105
FALLBACK_CHANNEL_ID=1571542249051783228
BOT_ALIASES=cûm slayer,cum slayer,slayer
ALLOW_DMS=1
AUTO_VOICE=on
DAILY_ROAST=on

# --- Anti-boucle et limites ---
BOT_LOOP_MAX=5
BOT_LOOP_WINDOW_MS=600000
BOT_AUTHOR_COOLDOWN_MS=5000
USER_COOLDOWN_MS=10000
GLOBAL_WINDOW_MS=600000
GLOBAL_MAX=20
WEBHOOK_TIMEOUT_MS=15000

# --- Santé (watchdog local) ---
WATCHDOG_INTERVAL_MS=5000
WATCHDOG_ACTIVITY_MAX_MS=90000
WATCHDOG_CLOCK_JUMP_MS=30000
WATCHDOG_STARTUP_GRACE_MS=120000
WATCHDOG_FAILS_TO_EXIT=1
